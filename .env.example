# Secrets live in Infisical (project: starterkit). This file only lists key names; never commit real values.
# Infisical dashboard: https://app.infisical.com  (docs: https://infisical.com/docs/documentation/getting-started/introduction)
#
# Two ways to get a working .env:
#   1. Infisical:   `infisical login`, then `pnpm secrets:seed dev` fills what it can generate
#                   and lists the rest (see packages/env/README.md).
#   2. No accounts: `pnpm setup:local` writes a root .env for running on one machine.
#
# GENERATED by `pnpm env:example` from the key definitions. Do not edit by hand.

# --- Infisical path: /api ---

# development | test | production. Defaults to development. Optional.
NODE_ENV=

# Set to 1 to skip validation, for CI builds that have no secrets. Never in production. Optional.
SKIP_ENV_VALIDATION=

# Origin of the platform app, the signed-in web app (scheme and host, no path). The API allows it through CORS, emails build their footer links from it, and auth allows it for sign-in redirects and passkeys. Where: The deployed platform URL (https://...)
WEB_ORIGIN=

# Port the API listens on. The web apps reach it at this port in development. Optional.
PORT=

# Postgres connection string: postgres://USER:PASSWORD@HOST:PORT/DB Where: Neon, Supabase or RDS connection string. Locally: `pnpm infra:postgres:up`.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/starterkit

# The address emails are sent from, for the smtp transport. With Novu the sender is set on the email integration in Novu's dashboard. Optional. Where: An address on a domain you control and have verified with your email provider
EMAIL_FROM_ADDRESS=

# How notify() delivers: novu (staging and production), smtp (development: sends to the Mailpit inbox) or log (tests). Production only accepts novu.
NOTIFICATIONS_TRANSPORT=

# Region of your Novu account. A key from one region is rejected by the other with 'API Key not found'. Optional.
NOVU_REGION=

# Novu secret key. Required when NOTIFICATIONS_TRANSPORT is novu; also used by the bridge that Novu calls. Required in test, staging, prod; optional elsewhere. Where: https://dashboard.novu.co/api-keys (use the dashboard of your region)
NOVU_SECRET_KEY=

# Host of the plain SMTP server for the smtp transport (Mailpit in development). Optional.
SMTP_HOST=

# Port of that SMTP server (Mailpit listens on 1025). Optional.
SMTP_PORT=

# Log shipping (optional): the ingesting host of the Better Stack source, for example s123.eu-nbg-2.betterstackdata.com. Needs BETTERSTACK_SOURCE_TOKEN as well. Optional. Where: Better Stack, Logs, Sources, your source (the host shown on the source's page)
BETTERSTACK_INGESTING_HOST=

# Log shipping (optional): the Better Stack source token. Leave empty to keep logs on standard output only. Optional. Where: Better Stack, Logs, Sources, your source
BETTERSTACK_SOURCE_TOKEN=

# Error reporting (optional): the Sentry DSN for the API. Leave empty to turn error reporting off. Optional. Where: Sentry project settings, Client Keys (DSN). Use an EU organization: the host ends in .de.sentry.io
SENTRY_DSN=

# The environment name Sentry shows for the API (development, staging, production), so staging errors are not mixed with production. Optional.
SENTRY_ENVIRONMENT=

# The version Sentry tags API errors with, usually the git commit SHA, set by the deploy. Leave empty to send none. Optional.
SENTRY_RELEASE=

# --- Infisical path: /internationalization ---

# Translation tooling (optional): API key for `pnpm translate`. Only needed by whoever translates new text. Optional. Where: https://languine.ai
LANGUINE_API_KEY=

# Translation tooling (optional): Languine project ID for `pnpm translate`. Kept in env, not languine.json, so it stays out of git. Optional. Where: https://languine.ai (project settings, starts with prj_)
LANGUINE_PROJECT_ID=

# --- Infisical path: /native ---

# Product analytics (optional): the PostHog project key for the native app. Leave empty to turn analytics off. Optional. Where: https://eu.posthog.com (Project settings, starts with phc_)
EXPO_PUBLIC_POSTHOG_TOKEN=

# Error reporting (optional): the Sentry DSN for the native app. Leave empty to turn error reporting off. Optional. Where: Sentry project settings, Client Keys (DSN). Use an EU organization: the host ends in .de.sentry.io
EXPO_PUBLIC_SENTRY_DSN=

# The environment name Sentry shows for the native app (development, staging, production), so staging errors are not mixed with production. Optional.
EXPO_PUBLIC_SENTRY_ENVIRONMENT=

# --- Infisical path: /web ---

# Product analytics (optional): the PostHog project key for the website. Leave empty to turn analytics off. Optional. Where: https://eu.posthog.com (Project settings, starts with phc_)
NEXT_PUBLIC_POSTHOG_TOKEN=

# Status link (optional): the public Better Stack status page the website footer links to. Optional. Where: Better Stack, Status pages
BETTERSTACK_STATUS_URL=

# Status indicator (optional): a Better Stack Uptime API token (read access) for the website footer's status dot. Optional. Where: Better Stack, Uptime, Integrations, API tokens
BETTERSTACK_UPTIME_TOKEN=

# Error reporting (optional): the Sentry DSN for the website and the platform. Leave empty to turn error reporting off. Optional. Where: Sentry project settings, Client Keys (DSN). Use an EU organization: the host ends in .de.sentry.io
NEXT_PUBLIC_SENTRY_DSN=

# The environment name Sentry shows for the website and the platform (development, staging, production), so staging errors are not mixed with production. Optional.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# Source maps (optional, build time): lets the web build upload source maps to Sentry so stack traces show real code. Without it the build still works. Optional. Where: Sentry, Settings, Developer Settings, Organization tokens
SENTRY_AUTH_TOKEN=

# Source maps (optional, build time): the Sentry organization slug. Optional.
SENTRY_ORG=

# Source maps (optional, build time): the Sentry project slug for the web apps. Optional.
SENTRY_PROJECT=
