{
  "name": "my-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "ultracite check",
    "check-types": "turbo run check-types",
    "db:check": "pnpm --filter @repo/db db:check",
    "db:generate": "pnpm --filter @repo/db db:generate",
    "db:migrate": "pnpm --filter @repo/db db:migrate",
    "db:push": "pnpm --filter @repo/db db:push",
    "db:studio": "pnpm --filter @repo/db studio",
    "dev": "turbo run dev",
    "emails:preview": "pnpm --filter @repo/emails preview",
    "env:example": "pnpm --filter @repo/env env:example",
    "env:pull": "pnpm --filter @repo/env env:pull",
    "fix": "ultracite fix",
    "infra:down": "pnpm infra:postgres:down && pnpm infra:mailpit:down",
    "infra:mailpit:down": "docker compose -f infra/mailpit/docker-compose.yml down",
    "infra:mailpit:up": "docker compose -f infra/mailpit/docker-compose.yml up -d --wait",
    "infra:postgres:down": "docker compose -f infra/postgres/docker-compose.yml down",
    "infra:postgres:up": "docker compose -f infra/postgres/docker-compose.yml up -d --wait",
    "infra:up": "pnpm infra:postgres:up && pnpm infra:mailpit:up",
    "novu:tunnel": "pnpm --filter @repo/notifications tunnel",
    "prepare": "husky",
    "secrets:push": "infisical secrets set --env=dev --path=/api --file=.env",
    "secrets:seed": "pnpm --filter @repo/env secrets:seed",
    "setup:local": "pnpm --filter @repo/env setup:local",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @repo/db test:integration",
    "theme:generate": "pnpm --filter @repo/config theme:generate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2",
    "ultracite": "7.12.4"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.22.0",
      "onFail": "download"
    }
  }
}
