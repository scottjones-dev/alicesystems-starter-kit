{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next",
    "ultracite/biome/vitest"
  ],
  "files": {
    // Not code we write:
    // - resources.ts is generated by `pnpm catalogs:generate`, and a test checks it matches the
    //   generator's output, so the formatter must not rewrite it;
    // - the native app's assets are icon and image files from Expo's template;
    // - packages/ui/src/components is written by the shadcn CLI and must stay as it writes it,
    //   so `shadcn add --overwrite` shows only real changes.
    "includes": [
      "!packages/internationalization/src/resources.ts",
      "!apps/native/assets",
      "!packages/ui/src/components"
    ]
  },
  "overrides": [
    {
      // Metro loads its config as CommonJS, where `__dirname` is the only way to get the folder.
      // The rule's auto-fix swaps in `import.meta.dirname`, which turns the file into an ES
      // module and breaks `require`, so the rule is off for this file.
      "includes": ["apps/native/metro.config.js"],
      "linter": {
        "rules": { "correctness": { "noGlobalDirnameFilename": "off" } }
      }
    }
  ]
}
